{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaarigar/schema/glossary.schema.json",
  "title": "Glossary",
  "description": "Array of multilingual, image-led glossary terms. content/glossary/glossary.json. Tool/Wood Finders read from here.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "term"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "term": {
        "type": "object", "additionalProperties": false, "required": ["en"],
        "description": "The term per language. pa/bgc empty until human-translated.",
        "properties": { "en": {"type":"string"}, "hi": {"type":"string"}, "pa": {"type":"string"}, "bgc": {"type":"string"} }
      },
      "roman": { "type": "string", "description": "Roman workshop spelling for search, e.g. gunia, sutli." },
      "definition": { "$ref": "#/$defs/localizedString" },
      "category": { "enum": ["tool", "wood", "material", "joint", "technique", "finishing", "hardware", "business", "safety"] },
      "image": { "type": "string" },
      "audio": {
        "type": "object", "additionalProperties": false,
        "properties": { "en": {"type":"string"}, "hi": {"type":"string"}, "pa": {"type":"string"}, "bgc": {"type":"string"} }
      },
      "relatedIds": { "type": "array", "items": { "type": "string" }, "description": "Other glossary/tool/wood ids." },
      "verified": { "type": "boolean" },
      "source": { "type": "string" }
    }
  },
  "$defs": {
    "localizedString": {
      "type": "object", "additionalProperties": false, "required": ["en"],
      "properties": { "en": {"type":"string"}, "hi": {"type":"string"}, "pa": {"type":"string"}, "bgc": {"type":"string"} }
    }
  }
}
