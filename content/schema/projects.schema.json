{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaarigar/schema/projects.schema.json",
  "title": "Projects",
  "description": "Array of Project Library entries (\"I want to build X\"). content/projects/projects.json.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "difficulty", "i18n"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "e.g. stool, chowki, wardrobe, modular-kitchen" },
      "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
      "estHours": { "type": "number", "minimum": 0 },
      "image": { "type": "string" },
      "skillsNeeded": {
        "type": "array",
        "items": { "type": "string", "pattern": "^l[0-9]{2}[a-z0-9-]+$" },
        "description": "Lesson ids this project draws on."
      },
      "tools": { "type": "array", "items": { "type": "string" } },
      "materials": { "type": "array", "items": { "type": "string" } },
      "estimateHint": {
        "$ref": "#/$defs/localizedString",
        "description": "Business tie-in: rough per-sq-ft framing; state face-vs-developed-area method."
      },
      "i18n": {
        "type": "object", "additionalProperties": false, "required": ["en"],
        "properties": {
          "en": { "$ref": "#/$defs/projectText" },
          "hi": { "$ref": "#/$defs/projectText" },
          "pa": { "$ref": "#/$defs/projectText" },
          "bgc": { "$ref": "#/$defs/projectText" }
        }
      },
      "translationStatus": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "en": { "$ref": "#/$defs/tstatus" }, "hi": { "$ref": "#/$defs/tstatus" },
          "pa": { "$ref": "#/$defs/tstatus" }, "bgc": { "$ref": "#/$defs/tstatus" }
        }
      }
    }
  },
  "$defs": {
    "tstatus": { "enum": ["authored", "draft-needs-review", "machine-draft", "missing"] },
    "projectText": {
      "type": "object", "additionalProperties": false, "required": ["title", "summary"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "outcome": { "type": "string" }
      }
    },
    "localizedString": {
      "type": "object", "additionalProperties": false, "required": ["en"],
      "properties": { "en": {"type":"string"}, "hi": {"type":"string"}, "pa": {"type":"string"}, "bgc": {"type":"string"} }
    }
  }
}
