{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaarigar/schema/woods.schema.json",
  "title": "Woods & sheet goods",
  "description": "Array of timber and sheet-good entries. content/woods/woods.json.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "kind", "names"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "e.g. sheesham, marine-ply, mdf" },
      "kind": { "enum": ["solid-timber", "sheet-good", "surfacing"] },
      "names": {
        "type": "object", "additionalProperties": false, "required": ["en"],
        "properties": { "en": {"type":"string"}, "hi": {"type":"string"}, "pa": {"type":"string"}, "bgc": {"type":"string"} }
      },
      "botanical": { "type": "string", "description": "For solid timbers, e.g. Dalbergia sissoo." },
      "isStandard": { "type": "string", "description": "For sheet goods, e.g. IS:710 (BWP), IS:303 (MR/BWR). Confirm revision on BIS before publishing." },
      "grade": { "type": "string", "description": "e.g. MR, BWR, BWP/Marine." },
      "priceTier": { "enum": ["low", "low-mid", "mid", "mid-high", "high"] },
      "waterResistance": { "enum": ["none", "moisture-resistant", "boiling-water-resistant", "waterproof", "na"] },
      "workability": { "$ref": "#/$defs/localizedString" },
      "typicalUses": { "$ref": "#/$defs/localizedString" },
      "image": { "type": "string" },
      "verified": { "type": "boolean", "description": "false = figures (esp. price/IS revision) pending local confirmation." },
      "source": { "type": "string" }
    }
  },
  "$defs": {
    "localizedString": {
      "type": "object", "additionalProperties": false, "required": ["en"],
      "properties": { "en": {"type":"string"}, "hi": {"type":"string"}, "pa": {"type":"string"}, "bgc": {"type":"string"} }
    }
  }
}
