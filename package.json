{
  "name": "kaarigar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Kaarigar — free, static, mobile-first, multilingual woodworking training platform (GitHub Pages).",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-content-index.mjs && vite-react-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "verify:videos": "node scripts/verify-videos.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "test": "vitest run",
    "subset:fonts": "python scripts/subset-fonts.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
